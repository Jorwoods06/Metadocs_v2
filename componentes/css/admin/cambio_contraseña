/* Formulario de cambio de contraseña */
#form {
    background-color: #fff;
    border-radius: 20px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    max-width: 500px;
    margin: 60px auto;
    padding: 40px 30px;
}

#form h2 {
    font-size: 1.5em;
    text-align: center;
    color: #1c1c1c;
}

#form p#subtitulo {
    text-align: center;
    color: #999;
    font-size: 0.95em;
    margin-bottom: 25px;
}

#form label {
    margin-bottom: 8px;
    display: block;
    color: #333;
    font-weight: 500;
}

#form input {
    width: 100%;
    padding: 16px;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 1em;
    margin-bottom: 25px;
}

#form #btn_iniciar {
    width: 100%;
    padding: 14px;
    font-size: 1em;
    border-radius: 20px;
    background-color: #3D688A;
    color: white;
    border: none;
    font-weight: bold;
    transition: background 0.3s;
}

#form #btn_iniciar:hover {
    background-color: #2a4860;
}
